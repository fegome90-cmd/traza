root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Preserve evidence, raw samples and the adopted constitution verbatim.
[{data/**,qa/**,licenses/**,docs/governance/AGENTIC-CONSTITUTION-v1.0.md}]
trim_trailing_whitespace = false
insert_final_newline = unset
